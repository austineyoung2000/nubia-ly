<resources>
    <style name="Theme.NubiaLy" parent="Theme.Material3.Dark.NoActionBar">
        <item name="sliderStyle">@style/Widget.NubiaLy.Slider</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_container_high</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Widget.NubiaLy.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">9dp</item>
        <item name="haloRadius">18dp</item>
        <item name="tickVisible">false</item>
        <item name="thumbColor">@color/primary</item>
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/surface_container_high</item>
    </style>
</resources>
